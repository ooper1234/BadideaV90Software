# v92isp native Windows configuration
# Setup-Windows.ps1 automatically replaces BIND_IP/ADVERTISE_IP with the
# Windows IPv4 address used to reach SIP_SERVER.
BIND_IP=192.168.2.38
ADVERTISE_IP=192.168.2.38
SIP_SERVER=192.168.2.35:5060
SIP_USER=101
SIP_PASSWORD=
SIP_PORT=5060
RTP_PORT=10000
REGISTER_EXPIRES=300

# auto = V.8 -> V.22bis/V.22 using SpanDSP, then legacy fallback.
# v92 exists only as an experimental Quick Connect handshake; full 56K is not done.
# MODE options: auto, v90, v92, v22bis, v22, v21
# v90 = real V.8 digital-V.90 + Phase-2 lab (not full data yet)
# v92 = real Quick Connect handshake lab (not full data yet)
MODE=v90

PPP_LOCAL_IP=192.168.137.1
PPP_PEER_IP=192.168.137.2
PPP_MTU=296
DNS1=1.1.1.1
DNS2=8.8.8.8
REQUIRE_PAP=0
PAP_SECRETS=config\\pap-secrets.txt
DEBUG=1




























































































































































